# REQUIRED: the stable address used by phones on your home network.
# Change this example IP to your server's LAN IP. Include the port for HTTP.
# This address is printed into every QR code. Avoid localhost/127.0.0.1.
APP_ORIGIN=http://192.168.1.50:8080

# Optional: host port and interface. Match APP_ORIGIN if you change the port.
HTTP_PORT=8080
HTTP_BIND_ADDRESS=0.0.0.0
# Upload processing and UI ZIP exports use RAM-backed temporary storage.
# Large inventories should use scheduled backups; see docs/BACKUP-RESTORE.md.
# APP_TMP_SIZE=512m

# Local AI is OFF by default. To turn it on, uncomment both lines below,
# then follow the model-download step in README.md before uploading photos.
# COMPOSE_PROFILES=ai
# AI_URL=http://ollama:11434

# Optional AI settings. Use the same model name when downloading the model.
# AI_MODEL=qwen3-vl:2b-instruct-q4_K_M
# AI_MEMORY_LIMIT=4g
# AI_CPU_LIMIT=2

# Daily snapshots include the SQLite database and original/photo derivatives.
# Keep 1 to 7 snapshots. The backup volume stays on this server, so also export
# backups elsewhere if you want protection against a failed server/disk.
BACKUP_RETENTION=7
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_STARTUP_DELAY_SECONDS=300

# Optional: isolate multiple installations on one Docker host by giving each
# a unique Compose project name and host port before first startup.
# COMPOSE_PROJECT_NAME=home-inventory

# Source builds are the default; no published registry image is required.
# If you have a trusted prebuilt image, set both variables, then use
# docker compose up -d --no-build instead of --build.
# IMAGE_REF=ghcr.io/your-account/home-inventory:your-version
# IMAGE_PULL_POLICY=missing
